{
  "name": "@sharadox/account-web-library",
  "version": "0.1.0",
  "description": "Passwordless accounts for web applications: one-time codes, two-factor, roles, bans and OpenID Connect for people and agents.",
  "private": false,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "exports": {
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts",
        "./source/*/index.tsx"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "library-build",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:benchmark": "vitest bench --run --passWithNoTests",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit test:benchmark build",
    "prepare": "turborepo-configuration library && (husky || true)"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@sharadox/database-web-library": "0.1.0-development.14",
    "@sharadox/email-web-library": "0.8.0-account-experience.59",
    "@sharadox/icon-web-library": "0.7.0-account-experience.35",
    "@sharadox/internationalization-web-library": "^0.4.1",
    "@sharadox/protection-web-library": "0.1.0-development.12",
    "@sharadox/web-library": "^0.11.1",
    "kysely": "^0.28.20",
    "sharp": "0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@sharadox/es-lint-configuration-web-library": "^0.1.3",
    "@sharadox/library-build-web-library": "^0.2.1",
    "@sharadox/prettier-configuration-web-library": "^0.1.2",
    "@sharadox/turborepo-configuration-web-library": "^0.1.4",
    "@sharadox/type-script-configuration-web-library": "^0.2.3",
    "@sharadox/vitest-configuration-web-library": "^0.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "9.39.5",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "next": "16.4.5",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "turbo": "^2.11.13",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/account-web-library.git"
  },
  "homepage": "https://github.com/Sharadox/account-web-library#readme",
  "keywords": [
    "authentication",
    "authorization",
    "passwordless",
    "one-time-code",
    "totp",
    "openid-connect",
    "oauth",
    "roles"
  ],
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
